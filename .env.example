# Copy to .env (or .env.local) and fill in. Never commit real values.
# Everything here is server-only — none of it may be exposed via NEXT_PUBLIC_.

# MongoDB Atlas connection string and database name
MONGODB_URI=
MONGODB_DB_NAME=farmkorrect

# Termii SMS (verification codes and SMS password resets)
TERMII_API_KEY=
TERMII_SENDER_ID=
# Optional: defaults to https://v3.api.termii.com and the "dnd" channel
TERMII_BASE_URL=
TERMII_CHANNEL=
# Local development only: with no Termii keys, print SMS messages (codes,
# reset links) to the `npm run dev` terminal instead. Ignored in production.
SMS_DEV_CONSOLE=false

# Resend email (password-reset emails for accounts with a verified email)
RESEND_API_KEY=
EMAIL_FROM=

# Cloudinary (profile photos). Either paste the dashboard's API environment
# variable (cloudinary://<key>:<secret>@<cloud name>) as CLOUDINARY_URL, or
# fill in the three separate values. Server-only: never NEXT_PUBLIC_.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: profile photos' folder, defaults to farm-korret/avatars. Listing
# photos go beside it (farm-korret/products), or in <folder>/products when
# the folder doesn't end in /avatars.
CLOUDINARY_FOLDER=

# Paystack (bank list, account-name checks and transfer recipients for
# payout accounts). Server-only: never NEXT_PUBLIC_. Use a test key
# (sk_test_...) locally; set the live key (sk_live_...) only in the Vercel
# project's environment variables. Without it, Bank Details shows that
# verification is unavailable.
PAYSTACK_SECRET_KEY=

# Payouts (Wallet & Earnings). Transfers stay OFF unless this is exactly
# "true". Before turning it on in production: transfers must be enabled on
# the Paystack business, transfer OTP disabled (Settings > Preferences),
# the webhook URL set to <APP_URL>/api/webhooks/paystack, and the Paystack
# balance funded. A live key never sends transfers outside production.
PAYSTACK_TRANSFERS_ENABLED=false
# Bearer secret for POST /api/internal/payouts/process, which a scheduler
# calls every few minutes to send queued payouts and reconcile ones whose
# outcome isn't known yet. At least 32 characters; leave empty to disable.
PAYOUT_JOB_SECRET=

# Market orders (Milestone 5). Buyers pay through Paystack with the key
# above (test key: test payments only). The webhook URL must be set to
# <APP_URL>/api/webhooks/paystack with charge.success and refund events.
#
# Platform commission. There is deliberately NO default rate: until BOTH are
# set, payments are still collected but no seller earning is recorded (so
# nothing can be paid out); orders paid meanwhile are settled by the order
# job as soon as a policy is configured. COMMISSION_RATE_BPS is in basis
# points of the order's item subtotal (e.g. 250 = 2.5%), 0 to 5000.
# COMMISSION_POLICY_ID names the policy and is stored on every order it's
# applied to (letters, digits, . _ -), e.g. 2026-standard.
COMMISSION_POLICY_ID=
COMMISSION_RATE_BPS=
# Bearer secret for POST /api/internal/orders/process (a scheduler calls it
# every few minutes: expires unpaid orders, reconciles payments/refunds,
# retries ledger updates) and POST /api/internal/orders/issues (support
# closes a reported problem). At least 32 characters; empty disables both.
ORDER_JOB_SECRET=

# Bearer secret for POST /api/internal/notifications/process. No scheduler is
# included: set one up (e.g. a cron job, Vercel Cron or GitHub Actions) to
# call it every 1-2 minutes with "Authorization: Bearer <secret>". Each run
# creates any notifications still owed, recovers abandoned sends and sends a
# bounded batch of email/SMS/push deliveries (it returns counts only).
# In-app notifications don't depend on it. At least 32 characters; empty
# disables the endpoint (404).
NOTIFICATION_JOB_SECRET=

# Optional Web Push (browser notifications). Generate a key pair with
#   npx web-push generate-vapid-keys
# The private key is server-only: never put it in a NEXT_PUBLIC_ variable.
# WEB_PUSH_SUBJECT is a contact: mailto:you@example.com or an https:// URL.
# Leave all three empty to switch push off.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Public origin of the app. Reset links and the CSRF origin check use this,
# never the request's Host header. Must be https:// outside localhost.
APP_URL=http://localhost:3000

# Session cookie name
SESSION_COOKIE_NAME=fk_session

# Server secret for OTP / rate-limit HMACs, at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Set to true only when the app runs behind a proxy that overwrites
# X-Forwarded-For / X-Real-IP (e.g. Vercel). Enables per-IP rate limits.
TRUST_PROXY_HEADERS=false
