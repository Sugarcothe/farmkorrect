# Copy to .env (or .env.local) and fill in. Never commit real values.
# Everything here is server-only — none of it may be exposed via NEXT_PUBLIC_.

# MongoDB Atlas connection string and database name
MONGODB_URI=
MONGODB_DB_NAME=farmkorrect

# Termii SMS (verification codes and SMS password resets)
TERMII_API_KEY=
TERMII_SENDER_ID=
# Optional: defaults to https://v3.api.termii.com and the "dnd" channel
TERMII_BASE_URL=
TERMII_CHANNEL=
# Local development only: with no Termii keys, print SMS messages (codes,
# reset links) to the `npm run dev` terminal instead. Ignored in production.
SMS_DEV_CONSOLE=false

# Resend email (password-reset emails for accounts with a verified email)
RESEND_API_KEY=
EMAIL_FROM=

# Cloudinary (profile photos). Either paste the dashboard's API environment
# variable (cloudinary://<key>:<secret>@<cloud name>) as CLOUDINARY_URL, or
# fill in the three separate values. Server-only: never NEXT_PUBLIC_.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: defaults to farm-korret/avatars
CLOUDINARY_FOLDER=

# Paystack (bank list, account-name checks and transfer recipients for
# payout accounts). Server-only: never NEXT_PUBLIC_. Use a test key
# (sk_test_...) locally; set the live key (sk_live_...) only in the Vercel
# project's environment variables. Without it, Bank Details shows that
# verification is unavailable.
PAYSTACK_SECRET_KEY=

# Public origin of the app. Reset links and the CSRF origin check use this,
# never the request's Host header. Must be https:// outside localhost.
APP_URL=http://localhost:3000

# Session cookie name
SESSION_COOKIE_NAME=fk_session

# Server secret for OTP / rate-limit HMACs, at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Set to true only when the app runs behind a proxy that overwrites
# X-Forwarded-For / X-Real-IP (e.g. Vercel). Enables per-IP rate limits.
TRUST_PROXY_HEADERS=false
